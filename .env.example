# Copy to .env.local and fill in. All vars are public (shipped to the browser).

# Canonical URL of the site (used for metadata, sitemap and OG images).
# Local: http://localhost:3000 — Production: your Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email shown in the contact section (mailto: links).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
